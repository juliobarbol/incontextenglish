{
  // Sitio estático servido por Cloudflare Workers (static assets).
  // El único código de servidor es src/index.js, y `run_worker_first` lo limita
  // a /api/*: el resto de las rutas las sirve Workers directo desde ./public
  // El Worker desplegado se llama "cronometro", por el repo viejo del que salió
  // este. Workers Builds despliega ahí igual (ignora este campo), pero si el
  // nombre no coincide, un `npm run deploy` desde una máquina crea un Worker
  // nuevo llamado como diga acá, sin los custom domains. Dejarlo en cronometro.
  "name": "cronometro",
  "compatibility_date": "2026-08-01",
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "incontextenglish",
      "database_id": "1707273f-9964-491f-957e-933c5d8d1400"
    }
  ],
  // Tope de eventos por IP y por minuto en /api/evento. Una visita normal manda
  // menos de 15 (una página, algún clic, cuatro de scroll, dos del test); 60 deja
  // margen de sobra y corta a quien quiera llenar la base con un script.
  // El contador vive en el borde de Cloudflare y no guarda la IP en ningún lado.
  "ratelimits": [
    {
      "name": "LIMITE",
      "namespace_id": "1",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Limpieza de eventos viejos: lunes a las 3 UTC (medianoche en Argentina).
  // El handler `scheduled` de src/index.js borra lo de más de 12 meses.
  "triggers": {
    "crons": ["0 3 * * 1"]
  },
  "observability": {
    "enabled": true
  }
}
